SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional payment gateway (M-Pesa Daraja 2.0)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CALLBACK_SECRET=change-this-callback-secret
MPESA_CALLBACK_URL=
