# Optional S3-compatible object storage for off-site backups
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Moodle / External LMS integration
LMS_BASE_URL=
LMS_SERVICE_TOKEN=

# Optional LiveKit video conferencing (required for large multi-participant virtual classes)
