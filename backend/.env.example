NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AUTO_BACKUP_HOURS=24
# Optional: set a fixed password for locally seeded demo accounts. Leave blank to generate one once at first seed.
DEMO_PASSWORD=

# Optional production email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional payment gateway
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
PAYMENT_GATEWAY_URL=

# Public API URL used for M-Pesa callbacks and document verification
PUBLIC_API_URL=http://localhost:5000
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CALLBACK_SECRET=change-this-callback-secret
MPESA_CALLBACK_URL=

# Optional S3-compatible object storage for off-site backups
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Moodle/LMS defaults
LMS_BASE_URL=
LMS_SERVICE_TOKEN=

# Optional LiveKit video conferencing (required for production multi-user calls)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MATARA_LMS_DATA_DIR=
MATARA_DATA_DIR=
